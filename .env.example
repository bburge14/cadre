# Copy this file to .env and fill in what you need. Every value here has a
# working default if left unset -- .env itself is gitignored, never commit
# your real one.

# Which network interface the web dashboard listens on.
# 127.0.0.1 = only reachable from this machine. Safe default.
# 0.0.0.0   = reachable from your whole network (e.g. over Tailscale/LAN),
#             same as opening a port -- do NOT set this to 0.0.0.0 and then
#             also forward the port to the open internet without putting a
#             reverse proxy + TLS in front of it. Basic Auth-era instincts
#             don't apply here: this app now has real accounts, but it's
#             still a plain-HTTP dev server underneath.
#COMMAND_CENTER_HOST=127.0.0.1

# Port the dashboard listens on.
#COMMAND_CENTER_PORT=7420

# Port the session daemon listens on for the dashboard to talk to (loopback
# only, 127.0.0.1 -- never exposed beyond this machine). Only change this
# if 7421 is already in use by something else here.
#COMMAND_CENTER_DAEMON_PORT=7421

# The `claude` binary to invoke when starting/resuming sessions. Only need
# to set this if `claude` isn't on your PATH under the name Flask's process
# sees (e.g. you installed it somewhere nonstandard).
#CLAUDE_BIN=claude

# Where Claude Code's own global subagent definitions live. Leave unset
# unless you're doing something nonstandard -- the default matches Claude
# Code's own convention (~/.claude/agents) and is what every other Claude
# Code session on this machine already reads from.
#CLAUDE_AGENTS_DIR=/home/you/.claude/agents

# Flask session-cookie signing key. Leave unset -- one gets generated and
# persisted to instance/secret_key automatically on first run. Only set
# this explicitly if you're running multiple processes/replicas that need
# to share one signing key (not a normal single-instance setup).
#FLASK_SECRET_KEY=

# Set to true only once this dashboard is served over HTTPS (e.g. behind a
# reverse proxy terminating TLS). Leave false for plain-HTTP local/Tailscale
# use -- setting it true without actual HTTPS in front will lock you out,
# since the browser won't send the session cookie back over plain HTTP.
#COMMAND_CENTER_COOKIE_SECURE=false

# --- Everything below this line is also editable from the in-app Settings
# page (top-right nav once logged in) with no restart needed. These env
# vars only exist as an optional fallback default for anyone who prefers
# file-based config -- most people should just use the Settings page and
# leave all of these unset/commented out.

# Where repos get cloned into when you create a session from GitHub/GitLab
# instead of an existing local directory. Created automatically if missing.
#PROJECTS_ROOT=/home/you/projects

# GitHub OAuth App credentials (Settings -> Developer settings -> OAuth Apps
# on github.com). The exact callback URL to register is shown on the
# in-app Settings page.
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=

# GitLab OAuth Application credentials (User Settings -> Applications).
# GITLAB_BASE_URL only needs changing for a self-hosted GitLab instance.
#GITLAB_BASE_URL=https://gitlab.com
#GITLAB_CLIENT_ID=
#GITLAB_CLIENT_SECRET=
